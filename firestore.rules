rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'oposicionfisica@gmail.com' ||
        request.auth.token.email == 'gabriel.saceda@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidOwnerCreate() {
      return (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user') &&
        (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status == 'activo') &&
        (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan == 'gratuito') &&
        !request.resource.data.keys().hasAny(['emailManual']) &&
        (
          !request.resource.data.keys().hasAny(['email']) ||
          request.resource.data.email == request.auth.token.email
        );
    }

    function isValidOwnerUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly([
        'nombre', 'sexo', 'cuerpoObjetivo', 'peso', 'altura', 'edad',
        'fechaTipo', 'fechaConcreta', 'semanasAprox', 'objetivos',
        'diasEntreno', 'duracionSesion', 'experiencia', 'objetivoEntreno',
        'material', 'lesiones', 'updatedAt', 'lastLoginAt',
        'email', 'role', 'status', 'plan', 'createdAt'
      ]) &&
        (
          !affected.hasAny(['email']) ||
          (
            (!resource.data.keys().hasAny(['email']) || resource.data.email == '') &&
            request.resource.data.email == request.auth.token.email
          )
        ) &&
        (!affected.hasAny(['role']) || (!resource.data.keys().hasAny(['role']) && request.resource.data.role == 'user')) &&
        (!affected.hasAny(['status']) || (!resource.data.keys().hasAny(['status']) && request.resource.data.status == 'activo')) &&
        (!affected.hasAny(['plan']) || (!resource.data.keys().hasAny(['plan']) && request.resource.data.plan == 'gratuito')) &&
        (!affected.hasAny(['createdAt']) || !resource.data.keys().hasAny(['createdAt']));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && isValidOwnerCreate()) || isAdmin();
      // Email, rol, estado, plan y fecha de alta solo los puede cambiar un admin.
      allow update: if (isOwner(userId) && isValidOwnerUpdate()) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      match /marks/{markId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /activities/{activityId} {
        allow read: if isOwner(userId) || isAdmin();
        // Strava activities are written by the backend; the client can only
        // create manual activities or update an existing source unchanged.
        allow create: if isOwner(userId) &&
          (!request.resource.data.keys().hasAny(['source']) || request.resource.data.source == 'manual');
        allow update: if isOwner(userId) &&
          (request.resource.data.source == resource.data.source ||
            (!resource.data.keys().hasAny(['source']) && request.resource.data.source == 'manual'));
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /wellbeing/{entryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /{path=**}/marks/{markId} {
      allow read, delete: if isAdmin();
    }

    // El público solo puede consultar avisos activos; el admin puede gestionar todos.
    match /announcements/{announcementId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Cola de emails para la extensión Trigger Email: solo el admin encola.
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /publicRankings/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // Marcas públicas anónimas e inmutables: sin UID ni datos personales.
    // La propiedad se demuestra porque sourceMarkId es el ID de una marca
    // privada del propio usuario.
    match /publicMarks/{markId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['sourceMarkId', 'testId', 'testName', 'sexo', 'mark', 'createdAt']) &&
        request.resource.data.sourceMarkId is string &&
        request.resource.data.sourceMarkId.size() > 0 &&
        request.resource.data.sourceMarkId.size() <= 128 &&
        request.resource.data.testId is string &&
        request.resource.data.testId.matches('^(plm|pn|gc)-[a-z0-9-]+$') &&
        request.resource.data.testName is string &&
        request.resource.data.testName.size() > 0 &&
        request.resource.data.testName.size() <= 80 &&
        request.resource.data.sexo in ['Hombre', 'Mujer'] &&
        request.resource.data.mark is number &&
        request.resource.data.mark > 0 &&
        request.resource.data.mark < 100000;
      allow update: if false;
      allow delete: if request.auth != null && (
        isAdmin() ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/marks/$(resource.data.sourceMarkId))
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
